generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          String         @default("PATIENT") // ADMIN, DOCTOR, RECEPTIONIST, PATIENT
  avatar        String?
  phone         String?
  isActive      Boolean        @default(true)
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  doctor        Doctor?
  patient       Patient?
  staff         Staff?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String        @id @default(cuid())
  code        String        @unique // CARD, NEUR, PEDI, ONCO, ORTH, GENM
  name        String
  description String?
  headOfDept  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  doctors      Doctor[]
  appointments Appointment[]
}

model Doctor {
  id                  String         @id @default(cuid())
  doctorId            String         @unique // DOC-1001
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  email               String
  contact             String
  departmentId        String
  department          Department     @relation(fields: [departmentId], references: [id])
  specialization      String
  qualification       String
  experience          Int            @default(5)
  consultationFee     Float          @default(60.0)
  consultationTimings String         @default("09:00 AM - 01:00 PM, 04:00 PM - 07:00 PM")
  availabilityStatus  String         @default("AVAILABLE") // AVAILABLE, ON_LEAVE, BUSY
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  prescriptions       Prescription[]
  aiAnalyses          AIAnalysis[]

  @@index([departmentId])
  @@index([availabilityStatus])
}

model Patient {
  id                       String         @id @default(cuid())
  patientId                String         @unique // PAT-2001
  userId                   String?        @unique
  user                     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                 String
  dob                      DateTime
  gender                   String         // MALE, FEMALE, OTHER
  contact                  String
  email                    String
  address                  String
  bloodGroup               String         // A+, A-, B+, B-, AB+, AB-, O+, O-
  emergencyContact         String
  emergencyContactRelation String?
  medicalHistory           String?
  allergies                String?
  registrationDate         DateTime       @default(now())
  isDeleted                Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  appointments             Appointment[]
  medicalRecords           MedicalRecord[]
  prescriptions            Prescription[]
  labReports               LabReport[]
  aiAnalyses               AIAnalysis[]

  @@index([fullName])
  @@index([contact])
  @@index([bloodGroup])
}

model Staff {
  id           String      @id @default(cuid())
  staffId      String      @unique // STF-3001
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  contact      String
  role         String      // RECEPTIONIST, LAB_TECH, NURSE, PHARMACIST
  shift        String      @default("MORNING") // MORNING, EVENING, NIGHT
  departmentId String?
  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Appointment {
  id              String      @id @default(cuid())
  appointmentId   String      @unique // APT-4001
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  appointmentDate DateTime
  timeSlot        String      // 09:30 AM - 10:00 AM
  status          String      @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED
  type            String      @default("GENERAL") // GENERAL, FOLLOW_UP, EMERGENCY
  reason          String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([doctorId, appointmentDate, timeSlot])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([appointmentDate])
}

model MedicalRecord {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis      String
  symptoms       String
  clinicalNotes  String?
  vitals         String?   // JSON string of { bp, hr, temp, spo2, weight, height }
  recordDate     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model Medicine {
  id            String             @id @default(cuid())
  code          String             @unique // MED-101
  name          String
  genericName   String
  category      String             // ANTIBIOTIC, ANALGESIC, ANTIHYPERTENSIVE, ANTIDIABETIC, RESPIRATORY
  form          String             // TABLET, CAPSULE, SYRUP, INJECTION, INHALER
  strength      String             // 500mg, 10ml, 50mcg
  stockQuantity Int                @default(100)
  unitPrice     Float              @default(12.5)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id             String             @id @default(cuid())
  prescriptionId String             @unique // RX-5001
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId  String?
  diagnosis      String
  notes          String?
  issueDate      DateTime           @default(now())
  status         String             @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items          PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id             String        @id @default(cuid())
  prescriptionId String
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName   String
  dosage         String        // e.g. "500 mg"
  frequency      String        // e.g. "Twice a day (1-0-1) after meals"
  duration       String        // e.g. "5 days"
  instructions   String?       // e.g. "Take after food with warm water"

  @@index([prescriptionId])
}

model LabReport {
  id               String    @id @default(cuid())
  reportId         String    @unique // LAB-6001
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName         String    // Complete Blood Count, Lipid Profile, etc.
  category         String    // HEMATOLOGY, BIOCHEMISTRY, PATHOLOGY, ENDOCRINOLOGY
  testDate         DateTime  @default(now())
  resultDate       DateTime?
  status           String    @default("COMPLETED") // PENDING, PROCESSING, COMPLETED
  testParameters   String    // JSON string containing detailed results
  summary          String?
  technicianName   String?
  referredByDoctor String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([testName])
}

model AIAnalysis {
  id                     String    @id @default(cuid())
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               String
  doctor                 Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  symptoms               String
  symptomDuration        String
  vitals                 String    // JSON string of { temp, bp, hr, spo2, respiratoryRate }
  existingConditions     String?
  allergies              String?
  patientSummary         String
  differentialSuggestions String   // JSON string of differential diagnostics
  clinicalObservations   String
  recommendedNextSteps   String    // JSON string of next steps
  redFlags               String    // JSON string of alert flags
  disclaimer             String
  reviewedByDoctor       Boolean   @default(false)
  clinicianNotes         String?
  createdAt              DateTime  @default(now())

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, URGENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // LOGIN, CREATE_PATIENT, AI_ANALYSIS_RUN, etc.
  entity    String   // PATIENT, DOCTOR, APPOINTMENT, etc.
  entityId  String?
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}
