// MEDNEXUS - PostgreSQL Production Schema (3NF Compliant)
// To switch to PostgreSQL: set DATABASE_URL="postgresql://postgres:password@localhost:5432/mednexus_db?schema=public"
// and copy this file to schema.prisma or run with --schema=prisma/schema.postgresql.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DoctorStatus {
  AVAILABLE
  ON_LEAVE
  BUSY
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(PATIENT)
  avatar        String?
  phone         String?
  isActive      Boolean        @default(true)
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  doctor        Doctor?
  patient       Patient?
  staff         Staff?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  headOfDept  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  doctors      Doctor[]
  appointments Appointment[]
}

model Doctor {
  id                  String         @id @default(cuid())
  doctorId            String         @unique
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  email               String
  contact             String
  departmentId        String
  department          Department     @relation(fields: [departmentId], references: [id])
  specialization      String
  qualification       String
  experience          Int            @default(5)
  consultationFee     Float          @default(60.0)
  consultationTimings String         @default("09:00 AM - 01:00 PM, 04:00 PM - 07:00 PM")
  availabilityStatus  DoctorStatus   @default(AVAILABLE)
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  prescriptions       Prescription[]
  aiAnalyses          AIAnalysis[]

  @@index([departmentId])
  @@index([availabilityStatus])
}

model Patient {
  id                       String         @id @default(cuid())
  patientId                String         @unique
  userId                   String?        @unique
  user                     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                 String
  dob                      DateTime
  gender                   Gender
  contact                  String
  email                    String
  address                  String
  bloodGroup               String
  emergencyContact         String
  emergencyContactRelation String?
  medicalHistory           String?
  allergies                String?
  registrationDate         DateTime       @default(now())
  isDeleted                Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  appointments             Appointment[]
  medicalRecords           MedicalRecord[]
  prescriptions            Prescription[]
  labReports               LabReport[]
  aiAnalyses               AIAnalysis[]

  @@index([fullName])
  @@index([contact])
  @@index([bloodGroup])
}

model Staff {
  id           String      @id @default(cuid())
  staffId      String      @unique
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  contact      String
  role         String
  shift        String      @default("MORNING")
  departmentId String?
  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Appointment {
  id              String            @id @default(cuid())
  appointmentId   String            @unique
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])
  appointmentDate DateTime
  timeSlot        String
  status          AppointmentStatus @default(SCHEDULED)
  type            String            @default("GENERAL")
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([doctorId, appointmentDate, timeSlot])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([appointmentDate])
}

model MedicalRecord {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis      String
  symptoms       String
  clinicalNotes  String?
  vitals         String?
  recordDate     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model Medicine {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  genericName   String
  category      String
  form          String
  strength      String
  stockQuantity Int                @default(100)
  unitPrice     Float              @default(12.5)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id             String             @id @default(cuid())
  prescriptionId String             @unique
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId  String?
  diagnosis      String
  notes          String?
  issueDate      DateTime           @default(now())
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items          PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id             String        @id @default(cuid())
  prescriptionId String
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  @@index([prescriptionId])
}

model LabReport {
  id               String    @id @default(cuid())
  reportId         String    @unique
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName         String
  category         String
  testDate         DateTime  @default(now())
  resultDate       DateTime?
  status           String    @default("COMPLETED")
  testParameters   String
  summary          String?
  technicianName   String?
  referredByDoctor String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([testName])
}

model AIAnalysis {
  id                     String    @id @default(cuid())
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               String
  doctor                 Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  symptoms               String
  symptomDuration        String
  vitals                 String
  existingConditions     String?
  allergies              String?
  patientSummary         String
  differentialSuggestions String
  clinicalObservations   String
  recommendedNextSteps   String
  redFlags               String
  disclaimer             String
  reviewedByDoctor       Boolean   @default(false)
  clinicianNotes         String?
  createdAt              DateTime  @default(now())

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}
